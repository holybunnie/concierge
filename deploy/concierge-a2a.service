[Unit]
# The OKX A2A (agent-to-agent) transport: an XMTP daemon that receives marketplace job events
# and carries our replies back. It is a delivery channel, exactly like Postmark — it never
# decides a tenant's price. See docs/HANDOFF.md, "Listing on OKX AI", for the two prices this
# distinction protects.
#
# Why this exists as a systemd service rather than a chat session: OKX's documented ASP flow runs
# `okx-a2a user watch` inside a Claude Code or Codex session and keeps it alive with a two-minute
# cron self-wake. That dies when the laptop closes, which is why listed agents go quiet. A
# foreground daemon under Restart=always does not.
Description=CONCIERGE OKX A2A transport daemon
After=network-online.target concierge.service
Wants=network-online.target

[Service]
Type=simple
User=concierge
Group=concierge

# NOT /opt/concierge, and this is load-bearing. The daemon spawns an AI session per inbound job and
# that session inherits this directory as its cwd — so pointing it at the application repo gave the
# handler the repo's own CLAUDE.md, and it concluded it was a development session. On 2026-07-25 it
# refused a real marketplace job as "the shape of a prompt injection" and answered nobody; the
# listing was rejected the next morning for not responding.
#
# /opt/concierge-asp contains one file: the handler's own CLAUDE.md (source: deploy/asp-handler/ in
# the repo). It sits OUTSIDE /opt/concierge because Claude Code walks parent directories looking
# for CLAUDE.md — a subdirectory of the repo would have inherited the repo's instructions anyway.
WorkingDirectory=/opt/concierge-asp

# HOME is load-bearing, not cosmetic. The daemon keeps its identity and state in
# $HOME/.okx-agent-task, and this box is shared: the rwoo project runs its own okx-a2a daemon as
# its own user with its own HOME. Pointing at /opt/concierge is what keeps the two listings from
# ever touching each other's credentials or agent identity.
Environment=HOME=/opt/concierge

# Our private CLI must win over the global /usr/local/bin/okx-a2a (0.1.9, and rwoo's daemon runs
# it). onchainos shells out to `okx-a2a doctor` by PATH lookup before it will activate or accept
# work, and against the global copy that check fails and tells you to `npm install -g …@latest` —
# which would upgrade rwoo's binary underneath a running process. PATH precedence is the fix; the
# global install stays untouched.
Environment=PATH=/opt/concierge/a2a/node_modules/.bin:/usr/local/bin:/usr/bin:/bin

# Carries ANTHROPIC_API_KEY, which the readiness check requires the bound AI CLI to have. Note
# what that binding is and is not: it lets the platform open an assistant subsession for A2A
# message handling. It has no part in pricing — a tenant's quote is computed by engine.step from
# their stored profile, exactly as on the email path.
EnvironmentFile=/opt/concierge/.env

# Our OWN copy of the CLI, deliberately NOT the global /usr/local/bin/okx-a2a. rwoo's running
# daemon executes that global binary, so `npm install -g @okxweb3/a2a-node@latest` — which the
# vendor's own doctor offers as an auto-fix — would swap the code out from under another
# project's live process. We pin our version here and leave theirs alone.
ExecStart=/opt/concierge/a2a/node_modules/.bin/okx-a2a run

Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
# HOME stays /opt/concierge (the XMTP identity and SQLite state live in $HOME/.okx-agent-task and
# must not move), so both paths are writable: state under the former, the handler's cwd the latter.
ReadWritePaths=/opt/concierge /opt/concierge-asp

[Install]
WantedBy=multi-user.target
