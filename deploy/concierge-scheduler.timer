[Unit]
Description=Run the CONCIERGE scheduled worker every 15 minutes

[Timer]
# Every 15 minutes. The cadence is set by the most time-sensitive job, which is follow-ups and
# receipt anchoring — the summary is gated separately by profile.summary_policy.period_days
# (7 days by default), so running this often does NOT mean 96 summaries a day. A tenant whose
# summary is not due is a cheap no-op.
OnBootSec=5min
OnUnitActiveSec=15min
# Without this a box that was asleep at the boundary silently skips the tick entirely.
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
