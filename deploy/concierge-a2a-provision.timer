[Unit]
Description=Poll the OKX marketplace for accepted jobs and advance onboarding
# A buyer whose job is accepted at 3am gets their first question in seconds. This was 1min on the
# argument that the buyer's own reply latency dominates — true of a human owner, false of the OKX
# review harness, which is an automated buyer that answers instantly and gives up in under a minute.
# Measured 2026-07-27 on job 0x35ecdf02: accepted 16:33:01, tenant provisioned 16:35:40. Every one
# of those 2m39s was ours, and the reviewer read it as no deliverable.

[Timer]
OnBootSec=2min
OnUnitActiveSec=15s
AccuracySec=2s
# If the box was down, run once on the way back up rather than skipping the missed buyers.
Persistent=true
Unit=concierge-a2a-provision.service

[Install]
WantedBy=timers.target
