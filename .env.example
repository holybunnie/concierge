# CONCIERGE credentials. Copy to .env and fill in what you have.
# Partial is fine — missing values are reported as missing, never faked.
# .env is gitignored. Nothing here is ever written to a log.

# 1. VPS — the public hostname the Postmark inbound webhook will POST to
VPS_HOST=

# 2. Domain — inbound addresses become <tenant>@inbox.<CONCIERGE_DOMAIN>
CONCIERGE_DOMAIN=

# 3. Postmark — one server token covers inbound parse + outbound send
POSTMARK_SERVER_TOKEN=
POSTMARK_INBOUND_WEBHOOK_SECRET=

# 4. Cal.com — key is prefixed cal_
CAL_API_KEY=

# 5. OKX Agentic Wallet / OnchainOS
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# 6. X Layer signer. Develop on testnet (1952) first — it needs no real funds.
XLAYER_PRIVATE_KEY=
XLAYER_RPC=https://testrpc.xlayer.tech
XLAYER_CHAIN_ID=1952

# 7. LLM — understanding, drafting, vertical classification ONLY. Never a price (§2).
LLM_API_KEY=

# 8. OPTIONAL web search. Absent → onboarding uses built-in vertical templates and says so.
SEARCH_API_KEY=

# Local Postgres for phases 1-3
DATABASE_URL=postgresql://concierge:concierge@localhost:5432/concierge
